# Copy this file to .env and fill in your values
# .env is in .gitignore and will never be committed

OPENROUTER_API_KEY=sk-or-v1-your-actual-key-here

# Origin allowed by CORS. The browser normally reaches the API through the
# same-origin rewrite in frontend/vercel.json and sends no Origin header, so
# this only applies to genuine cross-origin callers. Set it to the Vercel
# production origin (scheme + host, no trailing slash); defaults to the local
# Vite dev server when unset.
FRONTEND_ORIGIN=https://your-project.vercel.app

# AWS S3 — used to persist analysis history. Optional: if unset, the
# history feature silently disables itself and everything else still works.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name
