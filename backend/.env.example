# Copy this file to .env and fill in your values
# .env is in .gitignore and will never be committed

OPENROUTER_API_KEY=sk-or-v1-your-actual-key-here

# Origin allowed by CORS. The browser normally reaches the API through the
# same-origin rewrite in frontend/vercel.json and sends no Origin header, so
# this only applies to genuine cross-origin callers. Set it to the Vercel
# production origin (scheme + host, no trailing slash); defaults to the local
# Vite dev server when unset.
FRONTEND_ORIGIN=https://your-project.vercel.app

# AWS S3 — used to persist analysis history. Optional: if unset, the
# history feature silently disables itself and everything else still works.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# Sentry — error and performance monitoring. Optional: leave unset and the
# SDK is never initialised, which is the sensible default for local work.
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
# Tags events by deployment so laptop errors stay out of the production feed.
SENTRY_ENVIRONMENT=production
# Fraction of requests traced for performance, 0 to 1. Defaults to 0.1, i.e.
# one request in ten. Raise it while investigating something, then put it back.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set to 1 to expose GET /sentry-debug, which raises on purpose so you can
# check events arrive. Leave unset everywhere else.
SENTRY_DEBUG_ROUTE=
